{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SolixDB API",
  "colors": {
    "primary": "#1362FF",
    "light": "#4E89FF",
    "dark": "#0A4FCC"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "getting-started",
              "authentication"
            ]
          },
          {
            "group": "API Usage",
            "pages": [
              "examples",
              "error-handling",
              "rate-limiting"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "REST API",
            "pages": [
              "api-reference/rest-api"
            ]
          },
          {
            "group": "GraphQL API",
            "pages": [
              "api-reference/graphql-api"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/solixdb",
          "icon": "github"
        },
        {
          "anchor": "Website",
          "href": "https://solixdb.xyz",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://solixdb.xyz"
      },
      {
        "label": "Support",
        "href": "mailto:support@solixdb.xyz"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/getting-started"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/solixdb",
      "github": "https://github.com/solixdb"
    },
    "links": [
      {
        "group": "Product",
        "pages": [
          {
            "name": "Website",
            "href": "https://solixdb.xyz"
          },
          {
            "name": "AnchorLabs",
            "href": "https://anchorlabs.solixdb.xyz"
          }
        ]
      }
    ]
  }
}
