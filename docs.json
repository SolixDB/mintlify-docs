{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SolixDB API",
  "colors": {
    "primary": "#1362FF",
    "light": "#4E89FF",
    "dark": "#0A4FCC"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "getting-started",
              "authentication"
            ]
          },
          {
            "group": "API Usage",
            "pages": [
              "examples",
              "error-handling",
              "rate-limiting"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "GraphQL API",
            "pages": [
              "api-reference/graphql-api",
              "api-reference/migration-guide"
            ]
          },
          {
            "group": "REST API (Legacy)",
            "pages": [
              "api-reference/rest-api"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/SolixDB",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@solixdb.xyz"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/getting-started"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/solixdb",
      "github": "https://github.com/SolixDB"
    }
  }
}
